# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
# Project URL (Dashboard > Settings > API). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Safe to expose to the browser (RLS protects data).
# Newer Supabase projects may call this the "publishable" key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key. NEVER expose to the browser, NEVER prefix with
# NEXT_PUBLIC_, NEVER log it. Only used by server-only modules.
# Newer Supabase projects may call this the "secret" key (sb_secret_...).
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# Public base URL of the app. Used to build QR code target URLs and the
# post-signout redirect. MUST match how you actually serve the app:
#   local dev:   http://localhost:3000   (plain http — https://localhost fails)
#   production:  https://your-domain.example
# If unset, the app falls back to http://localhost:3000 (local dev only).
NEXT_PUBLIC_APP_URL=http://localhost:3000
